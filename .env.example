# ── Required ────────────────────────────────────────────────────────────────
# JWT signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in production without this. Never commit a real key.
SECRET_KEY=

# ── Database ────────────────────────────────────────────────────────────────
# SQLite by default — no setup needed. In Docker, docker-compose overrides this
# with a Postgres URL.
DATABASE_URL=sqlite:///./khazana.db

# ── Environment ─────────────────────────────────────────────────────────────
# "development" or "production". Production enables strict secret checks and
# disables the interactive API docs.
ENVIRONMENT=development

# ── Auth ────────────────────────────────────────────────────────────────────
# How long an access token stays valid, in minutes. Default 12 hours.
ACCESS_TOKEN_MINUTES=720

# ── Limits ──────────────────────────────────────────────────────────────────
# Maximum size of a single document's text, in bytes. Default 2 MB.
MAX_UPLOAD_BYTES=2000000

# Requests allowed per IP per minute. Per-process — N workers means N times
# this limit. Move to Redis for multi-worker deployments.
RATE_LIMIT_PER_MINUTE=60

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API from a browser. Leave empty
# when the UI is served by this same app (the default).
CORS_ORIGINS=
